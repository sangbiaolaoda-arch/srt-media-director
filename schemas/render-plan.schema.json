{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "render-plan",
  "type": "object",
  "required": ["canvas", "beats"],
  "properties": {
    "canvas": {"type": "object"},
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["beat_id", "start_sec", "end_sec", "strategy",
                     "boxes", "fonts"],
        "properties": {
          "beat_id": {"type": "string"},
          "start_sec": {"type": "number"},
          "end_sec": {"type": "number"},
          "strategy": {"type": "string"},
          "boxes": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "required": ["x", "y", "w", "h"],
              "properties": {
                "x": {"type": "number"}, "y": {"type": "number"},
                "w": {"type": "number", "exclusiveMinimum": 0},
                "h": {"type": "number", "exclusiveMinimum": 0}
              }
            }
          },
          "fonts": {"type": "object"}
        }
      }
    }
  }
}
