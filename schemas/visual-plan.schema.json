{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "visual-plan",
  "type": "object",
  "required": ["global_visual_grammar", "beats"],
  "properties": {
    "global_visual_grammar": {"type": "object"},
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["beat_id", "narration", "visual_claim", "evidence",
                     "strategy", "emphasis_plan", "information_encoding",
                     "composition_thesis", "motion_policy", "camera_intent"],
        "properties": {
          "beat_id": {"type": "string"},
          "narration": {"type": "string", "minLength": 1},
          "visual_claim": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "minItems": 1},
          "strategy": {"enum": ["single_focus", "left_to_right_flow",
                                "cause_effect", "comparison",
                                "center_cluster", "before_after"]},
          "emphasis_plan": {"type": "object"},
          "information_encoding": {"type": "object"},
          "composition_thesis": {"type": "object"},
          "motion_policy": {"enum": ["required", "optional", "hold"]},
          "camera_intent": {"type": "object"}
        }
      }
    }
  }
}
