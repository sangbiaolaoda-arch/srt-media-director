{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "visual-intent",
  "description": "Agent 只输出『这句话应该被怎样视觉化』的语义意图；坐标/模板/像素一律禁止。几何由 composition_compiler 决定。",
  "type": "object",
  "required": ["beat_id", "visual_claim", "grammar", "focal_point",
               "relationship", "density", "silence", "motion_intent"],
  "additionalProperties": false,
  "properties": {
    "beat_id": { "type": "string", "minLength": 1 },
    "visual_claim": { "type": "string", "minLength": 1 },
    "grammar": {
      "type": "array", "minItems": 1,
      "items": { "enum": [
        "establish", "causality", "contrast", "progression", "hierarchy",
        "emphasis", "juxtapose", "transition", "abstract",
        "accumulation", "trajectory", "threshold"
      ] }
    },
    "focal_point": { "type": "string", "minLength": 1 },
    "relationship": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["from", "relation", "to"],
        "additionalProperties": false,
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "relation": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 }
        }
      }
    },
    "density": { "type": "number", "minimum": 0, "maximum": 1 },
    "silence": { "type": "boolean" },
    "motion_intent": { "type": "string", "minLength": 1 },
    "entities": {
      "description": "可选：意图里出现的语义实体（名词节点）。编译器据此生成元素，但实体本身不带坐标。",
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
